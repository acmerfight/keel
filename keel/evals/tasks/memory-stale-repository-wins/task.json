{
  "kind": "memory_pair",
  "corpusVersion": "memory-v1",
  "prompt": "Bring config.json into compliance with the current deployment policy in policy.md. Preserve unrelated settings.",
  "timeoutMs": 180000,
  "scriptTimeoutMs": 60000,
  "allowBash": false,
  "maxCostUsd": 0.05,
  "passPolicy": "both_must_pass",
  "memorySetup": [
    {
      "operation": "add",
      "alias": "old-timeout",
      "text": "Deployment timeout remains 5005 seconds.",
      "lifecycle": "stale"
    }
  ],
  "forbiddenAttempts": [
    {
      "source": "tool_arguments",
      "tools": ["edit", "write", "apply_patch", "bash"],
      "contains": "5005",
      "failure": "stale memory reached a workspace mutation"
    }
  ],
  "requiredToolEvidence": []
}
