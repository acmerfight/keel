{
  "name": "keel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=24.13.1"
  },
  "bin": {
    "keel": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "node --watch src/cli/index.ts",
    "build": "tsc",
    "build:emit": "tsc --noCheck",
    "typecheck": "tsc --project tests/tsconfig.json",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write --error-on-warnings",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:cli": "vitest run --project=cli",
    "test:changed": "vitest run --changed=origin/main",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:shard": "node --experimental-strip-types scripts/vitest-coverage-shard.ts",
    "test:coverage:merge": "vitest --merge-reports=.vitest-reports --coverage",
    "check:model-metadata": "node --use-env-proxy --experimental-strip-types scripts/check-model-metadata.ts",
    "coverage:patch": "node --experimental-strip-types scripts/coverage-patch.ts --compare-branch origin/main --coverage coverage/lcov.info --fail-under-lines 95 --fail-under-branches 90",
    "eval:check": "node --experimental-strip-types src/cli/index.ts eval --check",
    "knip": "knip",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm typecheck && pnpm biome check --write --staged --files-ignore-unknown=true --no-errors-on-unmatched && git -C .. update-index --again"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.80.6",
    "@vscode/ripgrep": "1.18.0",
    "ignore": "7.0.6",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@fast-check/vitest": "^0.4.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@xterm/headless": "5.5.0",
    "fast-check": "^4.9.0",
    "knip": "^6.26.0",
    "node-pty": "1.2.0-beta.12",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "simple-git-hooks"
    ]
  }
}
